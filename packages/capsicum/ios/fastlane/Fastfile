require 'yaml'

default_platform(:ios)

platform :ios do
  desc "Deploy to TestFlight"
  lane :beta do
    # ⚠ TestFlight より先に上げる (#1134)。TestFlight の処理待ちは止められ
    # やすく、後ろに置くと上がらないまま終わる。
    upload_dsyms_to_sentry
    api_key = app_store_connect_api_key(
      key_id: 'WLS8G4W44L',
      issuer_id: '69a6de71-e621-47e3-e053-5b8c7c11a4d1',
      key_filepath: File.expand_path('~/.config/capsicum/AuthKey_WLS8G4W44L.p8'),
    )
    upload_to_testflight(
      ipa: '../build/ios/ipa/capsicum.ipa',
      api_key: api_key,
    )
  end

  # Sentry に dSYM を上げる (#1134)。上げないと、capsicum 自身のフレーム
  # （App.framework = Dart AOT / Runner）だけがスタックで復元されない。
  #
  # ⚠ pubspec.yaml の `sentry: upload_debug_symbols` は sentry_dart_plugin の
  # 設定で、Apple の dSYM は対象外。
  # ⚠ トークンはリポジトリルートの .sentryclirc（デプロイ用）を sentry-cli が
  # 親ディレクトリを辿って拾う。
  # ⚠ 失敗しても TestFlight へのアップロードは止めない（Sentry 側の障害で
  # リリースを止めない）。失敗は警告として残し、あとで同じレーンを単独で回す。
  desc "Upload dSYMs of the last archive to Sentry"
  lane :upload_dsyms_to_sentry do
    dsyms = File.expand_path('../../build/ios/archive/Runner.xcarchive/dSYMs')
    begin
      # ⚠ org は pubspec.yaml の `sentry: org` が正本（二重に持たない・#1166）。
      org = YAML.load_file(File.expand_path('../../pubspec.yaml')).dig('sentry', 'org')
      UI.user_error!('pubspec.yaml に sentry.org が無い') if org.to_s.empty?
      UI.user_error!("dSYM が見つからない: #{dsyms}") unless Dir.exist?(dsyms)
      sh('sentry-cli', 'debug-files', 'upload',
         '--org', org, '--project', 'capsicum', dsyms)
      # ⚠⚠ sentry-cli は対象が無くても 0 で終わる (#1166)。capsicum 自身の
      # フレームを復元するのは App.framework の dSYM なので、それが入っていたかを
      # 自分で見る。⚠ 結果は必ず `DSYM_UPLOAD=` の 1 行で出す —— store-release の
      # 完了チェックがこの行を grep する（長いログの中の警告 1 行は見落とす）。
      if Dir.exist?(File.join(dsyms, 'App.framework.dSYM'))
        UI.success('DSYM_UPLOAD=ok')
      else
        UI.error("DSYM_UPLOAD=incomplete App.framework.dSYM が無い（Dart のフレームが復元されない）: #{dsyms}")
      end
    rescue => e
      UI.error("DSYM_UPLOAD=failed Sentry への dSYM アップロードに失敗（リリースは続行）: #{e.message}")
    end
  end

  desc "Submit to App Store"
  # `fastlane release skip_metadata:true` で、メタデータとスクリーンショットの段を
  # 飛ばして提出する。
  #
  # ⚠⚠ **もう片方のプラットフォームが「審査中」の間は、これを付けないと進まない**
  # （2026-10-10・v2.1.0）。アプリ情報（カテゴリ等）は iOS と macOS で共有で、
  # 片方が審査中だと状態が IN_REVIEW になる。deliver は編集できるアプリ情報を
  # PREPARE_FOR_SUBMISSION / WAITING_FOR_REVIEW / 却下 からしか探さないので、
  # `Cannot find edit app info... Retrying after N seconds` を繰り返して止まる
  # （版は作られ、「提出準備中」のまま残る）。⚠ 片方が「審査待ち」なら起きない。
  lane :release do |options|
    skip_metadata = [true, 'true'].include?(options[:skip_metadata])
    api_key = app_store_connect_api_key(
      key_id: 'WLS8G4W44L',
      issuer_id: '69a6de71-e621-47e3-e053-5b8c7c11a4d1',
      key_filepath: File.expand_path('~/.config/capsicum/AuthKey_WLS8G4W44L.p8'),
    )
    upload_to_app_store(
      ipa: '../build/ios/ipa/capsicum.ipa',
      api_key: api_key,
      submit_for_review: true,
      force: true,
      skip_binary_upload: true,
      skip_metadata: skip_metadata,
      skip_screenshots: skip_metadata,
      precheck_include_in_app_purchases: false,
    )
  end
end
