flutter/ephemeral/

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
x64/
x86/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# runner/*_test.cpp を cl で直接コンパイルしたときに出る成果物
# (#474 の web_push_* / notification_type_label / push_diagnostics のスタンドアロン
# 単体テスト)。ソースに .obj/.exe をコミットすることはないので一括無視する。
runner/*.obj
runner/*.exe
runner/*.ilk
runner/*.pdb
