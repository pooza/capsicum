default_platform(:mac)

platform :mac do
  desc "Deploy to TestFlight"
  lane :beta do
    # ⚠ TestFlight より先に上げる (#1134)。理由は iOS の Fastfile と同じ。
    upload_dsyms_to_sentry
    api_key = app_store_connect_api_key(
      key_id: 'WLS8G4W44L',
      issuer_id: '69a6de71-e621-47e3-e053-5b8c7c11a4d1',
      key_filepath: File.expand_path('~/.config/capsicum/AuthKey_WLS8G4W44L.p8'),
    )
    upload_to_testflight(
      pkg: '../build/macos/capsicum.pkg',
      api_key: api_key,
    )
  end

  # Sentry に dSYM を上げる (#1134)。注意点は iOS の Fastfile と同じ。
  # アーカイブは build-upload.md の `xcodebuild archive` が作るもの。
  desc "Upload dSYMs of the last archive to Sentry"
  lane :upload_dsyms_to_sentry do
    dsyms = File.expand_path('../../build/macos/capsicum.xcarchive/dSYMs')
    begin
      UI.user_error!("dSYM が見つからない: #{dsyms}") unless Dir.exist?(dsyms)
      sh('sentry-cli', 'debug-files', 'upload',
         '--org', 'b-shock-co-ltd', '--project', 'capsicum', dsyms)
    rescue => e
      UI.important("Sentry への dSYM アップロードに失敗（リリースは続行）: #{e.message}")
    end
  end

  desc "Submit to Mac App Store"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: 'WLS8G4W44L',
      issuer_id: '69a6de71-e621-47e3-e053-5b8c7c11a4d1',
      key_filepath: File.expand_path('~/.config/capsicum/AuthKey_WLS8G4W44L.p8'),
    )
    upload_to_app_store(
      pkg: '../build/macos/capsicum.pkg',
      api_key: api_key,
      platform: 'osx',
      submit_for_review: true,
      force: true,
      skip_binary_upload: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
