<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs push 通知 (#468)。macOS の entitlement キーは iOS の
	     `aps-environment` ではなく `com.apple.developer.aps-environment`。
	     iOS 流の `aps-environment` だと archive/署名は通るが runtime で
	     「not properly entitled for push notifications」(OSStatus 13) になり
	     登録失敗する (debug 版 1.34.0+98 で実証)。production は App Store /
	     TestFlight 配布の本番 APNs 環境。App ID jp.co.b-shock.capsicum の Push
	     Notifications capability が有効である必要がある (iOS と共通の
	     Universal Purchase App ID)。 -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- OAuth ログインの自前 localhost コールバックサーバ (#654) が
	     HttpServer.bind(127.0.0.1:7099) を Sandbox 下で listen / accept する
	     ために必要。事前の _checkOAuthPortAvailability の bind プローブも
	     同じ entitlement に依存する。内部ベータ 1.31.0+88 の実機ログで、
	     外部ブラウザ → localhost:7099 のループバック接続が Sandbox 下でも
	     成立する（6 秒で callback 受信）ことを実証済み。無いと bind が
	     SocketException でログイン開始時に中断する。 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Apple Music ナウプレ取得 (#668)。Sandbox 下でミュージック.app へ
	     Apple Events (AppleScript) を送るために必要。実際の送信時に TCC
	     「オートメーション」許可ダイアログが出る（NSAppleEventsUsageDescription
	     を文面に使う）。 -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- #668: automation.apple-events（modern・TCC ベース）だけだと、Sandbox 下で
	     ミュージック.app への Apple Events が procNotFound(-600) で弾かれ、対象すら
	     解決できなかった（build 109-116 の実機 Sentry で実証。AEDetermine も
	     NSAppleScript も bundleId/PID/name・thread を問わず -600）。特定アプリへの
	     送信を明示的に許可する temporary-exception を併用して対象を addressable に
	     する。MAS 審査で説明が要る点に留意（ナウプレ＝ミュージックの現在再生曲のみ
	     読み取り、制御はしない）。 -->
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Music</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.jp.co.b-shock.capsicum</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.jp.co.b-shock.capsicum</string>
	</array>
</dict>
</plist>
