<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- OAuth ログイン前の _checkOAuthPortAvailability が
	     ServerSocket.bind(127.0.0.1:7099) を Sandbox 下で実行するために
	     必要 (#382)。macOS は flutter_web_auth_2 に server impl が無く
	     実 OAuth サーバは立たないが、bind プローブ自体にこの entitlement
	     が要る。無いと bind が SocketException → ログインが oob fallback
	     に到達する前に中断する。 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.jp.co.b-shock.capsicum</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.jp.co.b-shock.capsicum</string>
	</array>
</dict>
</plist>
